# Développement local : utiliser un projet Supabase dédié aux tests.
# Ne jamais utiliser les identifiants de production.
# Configuration Supabase
# URL de votre projet Supabase
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# Clé publique (anon) de Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon

# SUPABASE_URL est optionnelle ; si définie, utiliser le même projet que ci-dessus.
# Clé de service (pour les opérations côté serveur)
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service

AUTH_JWT_SECRET=
BACKOFFICE_JWT_SECRET=
# Clé AES-256: 64 caractères hexadécimaux ou 32 octets encodés en base64
BACKOFFICE_TOTP_ENCRYPTION_KEY=
# En développement HTTP uniquement : false. En production HTTPS : true.
BACKOFFICE_COOKIE_SECURE=true
# false si app en HTTP (local/docker), true si HTTPS
AUTH_COOKIE_SECURE=false


# Configuration Brevo
# Clé API Brevo (obtenue depuis https://app.brevo.com/settings/keys/api)
BREVO_API_KEY=
# Email d'expéditeur vérifié dans Brevo
BREVO_FROM_EMAIL=

# Configuration du serveur
PORT=3000
# Ne pas définir NODE_ENV ici : dev/build/start sélectionnent leur mode.

# URL de base de l'application (pour les liens dans les emails)
# En production, mettre l'URL complète de votre site (ex: https://yams.example.com)
# En développement, peut être laissé vide (utilisera localhost automatiquement)
NEXT_PUBLIC_BASE_URL=
# Alternative: BASE_URL (sans le préfixe NEXT_PUBLIC)
BASE_URL=
